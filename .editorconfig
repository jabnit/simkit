# https://editorconfig.org
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,cff,md}]
indent_size = 2
end_of_line = lf

# The kit is stored byte-for-byte; do not let an editor rewrite it.
[_SIMKIT/**]
trim_trailing_whitespace = false
insert_final_newline = false
