# Hand-written repository files use LF.
*.md     text eol=lf
*.cff    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
.gitignore       text eol=lf
.gitattributes   text eol=lf
.editorconfig    text eol=lf

# Office files and archives are binary.
*.docx  binary
*.xlsx  binary
*.zip   binary
*.png   binary
*.jpg   binary

# The kit must stay byte-identical to the deployed copy on the share. Some CSV and TXT files are CRLF and are read
# as they are, so git does not normalise line endings under _SIMKIT.
_SIMKIT/** -text
